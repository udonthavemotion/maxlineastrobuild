---
interface Props {
  href: string;
  size?: "md" | "lg";
  block?: boolean;
  style?: "outline" | "primary" | "inverted" | "muted" | "luxury";
  class?: string;
  [x: string]: any;
}

const {
  href,
  block,
  size = "lg",
  style = "primary",
  class: className,
  ...rest
} = Astro.props;

const sizes = {
  lg: "px-6 py-3 text-lg",
  md: "px-4 py-2 text-base",
};

const styles = {
  outline: "bg-white border-2 border-brand-blue hover:bg-blue-50 text-brand-blue font-semibold",
  primary: "bg-brand-blue text-white hover:bg-blue-600 border-2 border-transparent font-semibold shadow-lg",
  inverted: "bg-white text-brand-dark border-2 border-transparent hover:bg-gray-100 font-semibold",
  muted: "bg-brand-silver hover:bg-silver-400 text-brand-dark border-2 border-transparent font-medium",
  luxury: "gradient-brand text-white hover:opacity-90 border-2 border-transparent font-bold shadow-xl",
};
---

<a
  href={href}
  {...rest}
  class:list={[
    "rounded-lg text-center transition-all duration-300 focus-visible:ring-2 ring-offset-2 ring-brand-blue transform hover:scale-105",
    block && "w-full",
    sizes[size],
    styles[style],
    className,
  ]}
  ><slot />
</a>
