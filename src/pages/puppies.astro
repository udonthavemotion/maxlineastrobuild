---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";

// TypeScript interface for Puppy data
interface Puppy {
  id: number;
  name: string;
  status: 'Available' | 'Reserved';
  dob: string;
  price: string;
  images: { src: string; alt: string }[];
}

// Mock data - TODO: Replace with fetch from Strapi: const response = await fetch('http://localhost:1337/api/puppies?populate=images'); const { data } = await response.json();
const mockPuppies: Puppy[] = [
  {
    id: 1,
    name: 'Scarlett',
    status: 'Available',
    dob: '2023-10-01',
    price: '$5,500',
    images: [{ src: 'https://placehold.co/400x300?text=Scarlett+Puppy', alt: 'Scarlett puppy' }]
  },
  {
    id: 2,
    name: 'Joker',
    status: 'Reserved',
    dob: '2023-09-15',
    price: '$5,200',
    images: [{ src: 'https://placehold.co/400x300?text=Joker+Puppy', alt: 'Joker puppy' }]
  },
  {
    id: 3,
    name: 'Raven',
    status: 'Available',
    dob: '2023-10-08',
    price: '$6,000',
    images: [{ src: 'https://placehold.co/400x300?text=Raven+Puppy', alt: 'Raven puppy' }]
  },
  {
    id: 4,
    name: 'Draco',
    status: 'Available',
    dob: '2023-09-22',
    price: '$5,300',
    images: [{ src: 'https://placehold.co/400x300?text=Draco+Puppy', alt: 'Draco puppy' }]
  },
  {
    id: 5,
    name: 'Deadpool',
    status: 'Reserved',
    dob: '2023-10-12',
    price: '$5,800',
    images: [{ src: 'https://placehold.co/400x300?text=Deadpool+Puppy', alt: 'Deadpool puppy' }]
  },
  {
    id: 6,
    name: 'Wolverine',
    status: 'Available',
    dob: '2023-09-28',
    price: '$5,400',
    images: [{ src: 'https://placehold.co/400x300?text=Wolverine+Puppy', alt: 'Wolverine puppy' }]
  }
];
---

<Layout title="Available Puppies">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Available Puppies</Fragment>
      <Fragment slot="desc">
        Browse our healthy English Bulldog puppies ready for adoption
      </Fragment>
    </Sectionhead>
    
    <main class="mt-16">
      <!-- Filter Controls -->
      <div class="mb-8 flex flex-col sm:flex-row gap-4 justify-center">
        <button 
          id="filter-all"
          class="px-4 py-2 rounded-lg bg-blue-500 text-white hover:bg-blue-600 transition-colors duration-200 font-medium"
          aria-label="Show all puppies"
        >
          All Puppies
        </button>
        <button 
          id="filter-available"
          class="px-4 py-2 rounded-lg bg-gray-200 text-gray-700 hover:bg-gray-300 transition-colors duration-200 font-medium"
          aria-label="Show available puppies only"
        >
          Available Only
        </button>
        <button 
          id="filter-reserved"
          class="px-4 py-2 rounded-lg bg-gray-200 text-gray-700 hover:bg-gray-300 transition-colors duration-200 font-medium"
          aria-label="Show reserved puppies only"
        >
          Reserved Only
        </button>
      </div>

      <!-- Puppies Grid -->
      <div id="puppies-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-7xl mx-auto">
        {mockPuppies.map((puppy) => (
          <article 
            class="bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300 puppy-card"
            data-status={puppy.status}
          >
            <div class="photo-hover relative">
              <!-- TODO: Replace this placeholder with your actual image path (e.g., from public/ or Strapi media URL). This is the spot to edit for custom images later. -->
              <img 
                src={puppy.images[0].src}
                alt={puppy.images[0].alt}
                loading="lazy"
                class="w-full h-48 object-cover"
              />
              <!-- Hover overlay text -->
              <div class="overlay-text">
                <h3 class="text-xl font-bold">{puppy.name}</h3>
                <p class="text-lg">{puppy.price}</p>
              </div>
            </div>
            
            <div class="p-6">
              <div class="flex items-center justify-between mb-3">
                <h3 class="text-xl font-bold text-gray-900">{puppy.name}</h3>
                <span class={`px-3 py-1 rounded-full text-sm font-medium ${
                  puppy.status === 'Available' 
                    ? 'bg-green-100 text-green-800' 
                    : 'bg-red-100 text-red-800'
                }`}>
                  {puppy.status}
                </span>
              </div>
              
              <div class="space-y-2 mb-4">
                <p class="text-gray-600">
                  <strong>Date of Birth:</strong> {new Date(puppy.dob).toLocaleDateString()}
                </p>
                <p class="text-gray-600">
                  <strong>Price:</strong> {puppy.price}
                </p>
              </div>
              
              <a 
                href={`/contact?puppy=${encodeURIComponent(puppy.name)}`}
                class="w-full bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600 transition-colors duration-200 font-medium text-center block"
                aria-label={`Inquire about ${puppy.name}`}
              >
                Inquire Now
              </a>
            </div>
          </article>
        ))}
      </div>
    </main>
  </Container>
</Layout>

<script>
  // Client-side filtering functionality
  function initializeFilters() {
    const filterButtons = document.querySelectorAll('[id^="filter-"]');
    const puppyCards = document.querySelectorAll('.puppy-card');
    
    filterButtons.forEach(button => {
      button.addEventListener('click', () => {
        // Update button states
        filterButtons.forEach(btn => {
          btn.classList.remove('bg-blue-500', 'text-white');
          btn.classList.add('bg-gray-200', 'text-gray-700');
        });
        button.classList.add('bg-blue-500', 'text-white');
        button.classList.remove('bg-gray-200', 'text-gray-700');
        
        // Filter puppies
        const filter = button.id.replace('filter-', '');
        
        puppyCards.forEach(card => {
          const status = card.getAttribute('data-status');
          
          if (filter === 'all') {
            (card as HTMLElement).style.display = 'block';
          } else if (filter === 'available' && status === 'Available') {
            (card as HTMLElement).style.display = 'block';
          } else if (filter === 'reserved' && status === 'Reserved') {
            (card as HTMLElement).style.display = 'block';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  }
  
  // Initialize filters when DOM is loaded
  document.addEventListener('DOMContentLoaded', initializeFilters);
</script> 