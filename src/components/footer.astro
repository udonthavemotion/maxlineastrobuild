---
import { Icon } from "astro-icon/components";
---

<footer class="bg-brand-dark text-white mt-20">
  <div class="max-w-7xl mx-auto px-4 py-12">
    <!-- Main Footer Content -->
    <div class="grid md:grid-cols-4 gap-8 mb-8">
      <!-- Brand Section -->
      <div class="md:col-span-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-10 h-10 bg-brand-blue rounded-full flex items-center justify-center">
            <span class="text-white font-bold">MB</span>
          </div>
          <div>
            <div class="font-heading font-bold text-xl">Maxline Bulldogs</div>
            <div class="text-brand-blue font-heading text-sm">× Horrorbullz HQ</div>
          </div>
        </div>
        <p class="text-gray-300 mb-4 max-w-md">
          Premier English Bulldog breeding partnership dedicated to producing healthy, 
          champion-quality bulldogs with exceptional temperament and conformation.
        </p>
                 <div class="flex items-center gap-4">
           <a href="#" class="text-gray-300 hover:text-brand-blue transition-colors">
             <Icon class="w-5 h-5" name="bx:bxl-facebook" />
           </a>
           <a href="#" class="text-gray-300 hover:text-brand-blue transition-colors">
             <Icon class="w-5 h-5" name="bx:bxl-instagram" />
           </a>
           <a href="#" class="text-gray-300 hover:text-brand-blue transition-colors">
             <Icon class="w-5 h-5" name="bx:bxl-youtube" />
           </a>
           <a href="#" class="text-gray-300 hover:text-brand-blue transition-colors">
             <Icon class="w-5 h-5" name="bx:bxs-envelope" />
           </a>
         </div>
      </div>
      
      <!-- Quick Links -->
      <div>
        <h4 class="font-bold text-lg mb-4">Our Dogs</h4>
        <ul class="space-y-2 text-gray-300">
          <li><a href="/studs" class="hover:text-brand-blue transition-colors">Available Studs</a></li>
          <li><a href="/puppies" class="hover:text-brand-blue transition-colors">Available Puppies</a></li>
          <li><a href="/bloodlines" class="hover:text-brand-blue transition-colors">Champion Bloodlines</a></li>
          <li><a href="/health" class="hover:text-brand-blue transition-colors">Health Testing</a></li>
        </ul>
      </div>
      
      <!-- Contact Info -->
      <div>
        <h4 class="font-bold text-lg mb-4">Contact</h4>
        <div class="space-y-3 text-gray-300">
                     <div class="flex items-center gap-2">
             <Icon class="w-4 h-4 text-brand-blue" name="bx:bxs-envelope" />
             <span>info@maxlinebulldogs.com</span>
           </div>
           <div class="flex items-center gap-2">
             <Icon class="w-4 h-4 text-brand-blue" name="bx:bxs-phone" />
             <span>(555) 123-4567</span>
           </div>
           <div class="flex items-center gap-2">
             <Icon class="w-4 h-4 text-brand-blue" name="bx:bxs-map" />
             <span>Premium Breeding Facility</span>
           </div>
        </div>
      </div>
    </div>
    
    <!-- Bottom Bar -->
    <div class="border-t border-gray-700 pt-8 flex flex-col md:flex-row justify-between items-center">
      <div class="text-gray-400 text-sm mb-4 md:mb-0">
        © {new Date().getFullYear()} Maxline Bulldogs × Horrorbullz HQ. All rights reserved.
      </div>
      <div class="flex items-center gap-6 text-sm text-gray-400">
        <a href="/privacy" class="hover:text-brand-blue transition-colors">Privacy Policy</a>
        <a href="/terms" class="hover:text-brand-blue transition-colors">Terms of Service</a>
        <a href="/health-guarantee" class="hover:text-brand-blue transition-colors">Health Guarantee</a>
      </div>
    </div>
    
    <!-- Professional Affiliations -->
    <div class="mt-8 pt-6 border-t border-gray-700">
      <div class="flex flex-wrap items-center justify-center gap-6 text-sm text-gray-400">
                 <div class="flex items-center gap-1">
           <Icon class="w-4 h-4 text-brand-blue" name="bx:bxs-award" />
           <span>AKC Registered</span>
         </div>
         <div class="flex items-center gap-1">
           <Icon class="w-4 h-4 text-brand-blue" name="bx:bxs-shield" />
           <span>Health Guaranteed</span>
         </div>
         <div class="flex items-center gap-1">
           <Icon class="w-4 h-4 text-brand-blue" name="bx:bxs-star" />
           <span>Champion Bloodlines</span>
         </div>
         <div class="flex items-center gap-1">
           <Icon class="w-4 h-4 text-brand-blue" name="bx:bxs-heart" />
           <span>Lifetime Support</span>
         </div>
      </div>
    </div>
  </div>
</footer>
